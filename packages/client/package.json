{
  "name": "@tetris/client",
  "version": "0.1.2",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:web": "node ../../node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "node ../../node_modules/wait-on/bin/wait-on tcp:127.0.0.1:5173 && node ../../node_modules/electron/cli.js .",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "node ../../node_modules/electron/cli.js .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "node ./scripts/package-unified.mjs mac",
    "dist:win": "node ./scripts/package-unified.mjs win",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64",
    "dist:all": "node ./scripts/package-unified.mjs mac && node ./scripts/package-unified.mjs win",
    "dist:host:mac": "node ./scripts/package-app.mjs host mac",
    "dist:host:win": "node ./scripts/package-app.mjs host win",
    "dist:client:mac": "node ./scripts/package-app.mjs client mac",
    "dist:client:win": "node ./scripts/package-app.mjs client win",
    "dist:apps:mac": "node ./scripts/package-app.mjs host mac && node ./scripts/package-app.mjs client mac",
    "dist:apps:win": "node ./scripts/package-app.mjs host win && node ./scripts/package-app.mjs client win",
    "dist:apps:all": "npm run dist:apps:mac && npm run dist:apps:win"
  },
  "dependencies": {
    "@tetris/shared": "0.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "35.7.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.qycd.tetrisversus",
    "productName": "Tetris Versus",
    "copyright": "Copyright © 2026 qYcd",
    "directories": {
      "output": "release/unified",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tetris Versus"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "electronVersion": "35.7.5",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "../shared/dist",
        "to": "shared/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../engine-c/build/Release",
        "to": "engine-c/build/Release",
        "filter": [
          "*.node"
        ]
      }
    ]
  },
  "description": "双人对战俄罗斯方块客户端（Electron）",
  "author": "qYcd"
}
