{
  "name": "@tetris/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/tsx/dist/cli.mjs src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "npm run build -w @tetris/shared",
    "dev:tsx": "tsx src/index.ts"
  },
  "dependencies": {
    "@tetris/shared": "0.1.0",
    "ws": "^8.18.1",
    "@tetris/engine-c": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
